<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch screen is plain emerald. The lotus is then drawn live by the app. -->
    <style name="Theme.QuranForWomen.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/emerald</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.QuranForWomen</item>
    </style>
    <style name="Theme.QuranForWomen" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
